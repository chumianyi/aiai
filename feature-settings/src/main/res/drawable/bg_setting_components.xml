<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 卡片背景 -->
    <drawable name="bg_setting_card">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="@dimen/corner_radius" />
        </shape>
    </drawable>

    <!-- 分组标题下方缩进分隔线 -->
    <drawable name="divider_setting">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <size android:height="@dimen/divider_height" />
            <solid android:color="@color/bg_divider" />
        </shape>
    </drawable>

    <!-- 图标圆形背景 -->
    <drawable name="bg_icon_circle">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="oval">
            <solid android:color="@color/primary_alpha" />
            <size android:width="@dimen/icon_bg_size" android:height="@dimen/icon_bg_size" />
        </shape>
    </drawable>

    <!-- 输入框背景 -->
    <drawable name="bg_input">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/bg_window" />
            <corners android:radius="@dimen/corner_radius_small" />
            <stroke android:width="1dp" android:color="@color/bg_divider" />
        </shape>
    </drawable>

    <!-- 搜索栏背景 -->
    <drawable name="bg_search_bar">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/bg_window" />
            <corners android:radius="@dimen/search_bar_height" />
        </shape>
    </drawable>

    <!-- 悬浮操作按钮背景 -->
    <drawable name="bg_fab">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="oval">
            <solid android:color="@color/primary" />
        </shape>
    </drawable>

    <!-- 标签背景 -->
    <drawable name="bg_tag">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="rectangle">
            <solid android:color="@color/primary_alpha" />
            <corners android:radius="@dimen/tag_height" />
        </shape>
    </drawable>

    <!-- 成功状态圆点 -->
    <drawable name="dot_success">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="oval">
            <solid android:color="@color/success" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </drawable>

    <!-- 错误状态圆点 -->
    <drawable name="dot_error">
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="oval">
            <solid android:color="@color/error" />
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </drawable>

    <!-- 右箭头 -->
    <drawable name="ic_arrow_right">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="24dp" android:height="24dp"
            android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="#9E9E9E"
                android:pathData="M8.59,16.59L13.17,12 8.59,7.41 10,6l6,6 -6,6z" />
        </vector>
    </drawable>

    <!-- 搜索图标 -->
    <drawable name="ic_search">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="24dp" android:height="24dp"
            android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="#9E9E9E"
                android:pathData="M15.5,14h-0.79l-0.28,-0.27C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99,-5zM9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z" />
        </vector>
    </drawable>

    <!-- 清除图标 -->
    <drawable name="ic_clear">
        <vector xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="24dp" android:height="24dp"
            android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="#9E9E9E"
                android:pathData="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z" />
        </vector>
    </drawable>

