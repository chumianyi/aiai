<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== 应用主主题（深色） ========== -->
    <style name="Theme.AiAi" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色 -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_container_dark</item>
        <item name="colorOnPrimary">@color/on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_dark</item>

        <!-- 次色 -->
        <item name="colorSecondary">@color/secondary_dark</item>
        <item name="colorSecondaryVariant">@color/secondary_container_dark</item>
        <item name="colorOnSecondary">@color/on_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container_dark</item>

        <!-- 第三色 -->
        <item name="colorTertiary">@color/tertiary_dark</item>
        <item name="colorOnTertiary">@color/on_tertiary_dark</item>
        <item name="colorTertiaryContainer">@color/tertiary_dark</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container_dark</item>

        <!-- 背景/表面 -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/on_background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorSurfaceContainer">@color/surface_container_dark</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_dark</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant_dark</item>

        <!-- 错误 -->
        <item name="colorError">@color/error_dark</item>
        <item name="colorOnError">@color/on_error_dark</item>
        <item name="colorErrorContainer">@color/error_container_dark</item>
        <item name="colorOnErrorContainer">@color/error_dark</item>

        <!-- 轮廓 -->
        <item name="colorOutline">@color/outline_dark</item>
        <item name="colorOutlineVariant">@color/outline_variant_dark</item>

        <!-- 窗口属性 -->
        <item name="android:windowBackground">@color/bg_page_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- 文字外观 -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.AiAi.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.AiAi.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.AiAi.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.AiAi.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.AiAi.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.AiAi.LabelLarge</item>

        <!-- 组件样式 -->
        <item name="materialButtonStyle">@style/Widget.AiAi.Button</item>
        <item name="chipStyle">@style/Widget.AiAi.Chip</item>
        <item name="textInputStyle">@style/Widget.AiAi.TextInputLayout</item>
        <item name="cardViewStyle">@style/Widget.AiAi.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.AiAi.BottomNavigationView</item>

        <!-- 其他 -->
        <item name="android:windowAnimationStyle">@style/Animation.AiAi</item>
        <item name="android:divider">@color/outline_variant_dark</item>
        <item name="android:dividerHeight">@dimen/divider_height</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSharedElementsUseOverlay">true</item>
        <item name="android:navigationBarDividerColor">@color/outline_variant_dark</item>
    </style>

</resources>
