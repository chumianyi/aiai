<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog" android:orientation="vertical"
    android:padding="@dimen/spacing_xl">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/theme_color_custom" android:textColor="@color/text_primary"
        android:textSize="@dimen/text_xl" android:textStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_colors"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_base"/>
</LinearLayout>
