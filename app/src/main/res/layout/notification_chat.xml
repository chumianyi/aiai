<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="@dimen/spacing_base">
    <ImageView android:layout_width="@dimen/avatar_md" android:layout_height="@dimen/avatar_md"
        android:src="@drawable/ic_logo"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_base" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/white"
            android:textSize="@dimen/text_md" android:textStyle="bold"/>
        <TextView android:id="@+id/text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/white"
            android:textSize="@dimen/text_sm"/>
    </LinearLayout>
</LinearLayout>
