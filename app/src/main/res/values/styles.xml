<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== 文字样式 ========== -->
    <style name="TextAppearance.AiAi.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_xxl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AiAi.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AiAi.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.AiAi.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.AiAi.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_xxs</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.AiAi.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AiAi.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_xxxs</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="TextAppearance.AiAi.BubbleUser" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/bubble_user_text</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.AiAi.BubbleAI" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/bubble_ai_text</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.AiAi.Code" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_code</item>
        <item name="android:background">@color/bg_input</item>
    </style>

    <!-- ========== 按钮样式 ========== -->
    <style name="Widget.AiAi.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:minHeight">@dimen/button_height_lg</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.AiAi.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.AiAi.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/radius_md</item>
    </style>

    <style name="Widget.AiAi.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="tint">@color/primary</item>
    </style>

    <style name="Widget.AiAi.Button.Floating" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/on_primary</item>
    </style>

    <!-- ========== 输入框样式 ========== -->
    <style name="Widget.AiAi.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <style name="Widget.AiAi.EditText" parent="Widget.Material3.TextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:padding">@dimen/padding_input_h</item>
    </style>

    <!-- ========== 卡片样式 ========== -->
    <style name="Widget.AiAi.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Widget.AiAi.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
    </style>

    <!-- ========== Chip样式 ========== -->
    <style name="Widget.AiAi.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipCornerRadius">@dimen/radius_circle</item>
    </style>

    <!-- ========== 底部导航 ========== -->
    <style name="Widget.AiAi.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bottom_nav_bg</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>

    <color name="bottom_nav_color">@color/bottom_nav_selected</color>

    <!-- ========== 工具栏 ========== -->
    <style name="Widget.AiAi.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/toolbar_bg</item>
        <item name="android:titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.AiAi.TitleMedium</item>
    </style>

    <!-- ========== 对话框 ========== -->
    <style name="Widget.AiAi.Dialog" parent="Widget.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">@dimen/dialog_corner_radius</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AiAi.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AiAi.Button.Text</item>
    </style>

    <!-- ========== 底部弹窗 ========== -->
    <style name="Widget.AiAi.BottomSheet" parent="Widget.Material3.BottomSheetModal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.AiAi.BottomSheet</item>
    </style>

    <!-- ========== 列表项 ========== -->
    <style name="Widget.AiAi.ListItem" parent="">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:padding">@dimen/spacing_base</item>
        <item name="android:minHeight">@dimen/list_item_height</item>
    </style>

    <!-- ========== 分割线 ========== -->
    <style name="Widget.AiAi.Divider" parent="">
        <item name="android:background">@color/divider</item>
        <item name="android:layout_height">@dimen/divider_height</item>
    </style>

    <!-- ========== 开关 ========== -->
    <style name="Widget.AiAi.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <!-- ========== 进度条 ========== -->
    <style name="Widget.AiAi.ProgressBar" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/progress_bar</item>
        <item name="strokeWidth">@dimen/progress_stroke</item>
    </style>

    <!-- ========== 滑块 ========== -->
    <style name="Widget.AiAi.Slider" parent="Widget.Material3.Slider">
        <item name="activeTickColor">@color/slider_active</item>
        <item name="inactiveTrackColor">@color/slider_inactive</item>
    </style>

    <!-- ========== 徽章 ========== -->
    <style name="Widget.AiAi.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/badge_text</item>
        <item name="android:textSize">@dimen/text_xxxs</item>
        <item name="android:minWidth">@dimen/badge_size</item>
        <item name="android:minHeight">@dimen/badge_size</item>
        <item name="android:gravity">center</item>
    </style>

<!-- ========== 额外文字样式 ========== -->
    <style name="TextAppearance.AiAi.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AiAi.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AiAi.ChatTimestamp" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_xxxs</item>
        <item name="android:textColor">@color/bubble_timestamp</item>
    </style>

    <style name="TextAppearance.AiAi.SettingTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AiAi.SettingDesc" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.AiAi.ButtonText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ========== 额外按钮样式 ========== -->
    <style name="Widget.AiAi.Button.Small" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:minWidth">64dp</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textSize">@dimen/text_xs</item>
    </style>

    <style name="Widget.AiAi.Button.Large" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textSize">@dimen/text_lg</item>
    </style>

    <style name="Widget.AiAi.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/error</item>
        <item name="android:textColor">@color/on_error</item>
    </style>

    <style name="Widget.AiAi.Button.Success" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/status_success</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ========== 额外卡片样式 ========== -->
    <style name="Widget.AiAi.CardView.Chat" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">@dimen/elevation_xs</item>
        <item name="cardCornerRadius">@dimen/bubble_radius</item>
        <item name="contentPaddingHorizontal">@dimen/bubble_padding_h</item>
        <item name="contentPaddingVertical">@dimen/bubble_padding_v</item>
    </style>

    <style name="Widget.AiAi.CardView.Settings" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ========== 额外Chip样式 ========== -->
    <style name="Widget.AiAi.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface_container</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.AiAi.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/surface_container_low</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ========== 额外进度条 ========== -->
    <style name="Widget.AiAi.ProgressBar.Linear" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/progress_bar</item>
        <item name="trackColor">@color/surface_variant</item>
    </style>

    <!-- ========== 额外对话框 ========== -->
    <style name="Widget.AiAi.Dialog.Wide" parent="Widget.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">@dimen/radius_xl</item>
    </style>

    <!-- ========== 额外列表项 ========== -->
    <style name="Widget.AiAi.ListItem.Icon" parent="">
        <item name="android:paddingStart">@dimen/spacing_base</item>
        <item name="android:paddingEnd">@dimen/spacing_base</item>
        <item name="android:minHeight">@dimen/list_item_height_lg</item>
    </style>

    <!-- ========== 额外工具栏 ========== -->
    <style name="Widget.AiAi.Toolbar.Centered" parent="Widget.Material3.Toolbar">
        <item name="titleCentered">true</item>
    </style>

    <!-- ========== 额外分割线 ========== -->
    <style name="Widget.AiAi.Divider.Thick" parent="">
        <item name="android:background">@color/divider</item>
        <item name="android:layout_height">@dimen/divider_height_thick</item>
    </style>

    <!-- ========== Tab样式 ========== -->
    <style name="Widget.AiAi.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/tab_indicator</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextColor">@color/text_tertiary</item>
    </style>

    <!-- ========== 菜单样式 ========== -->
    <style name="Widget.AiAi.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_dialog</item>
    </style>

    <!-- ========== 下拉刷新 ========== -->
    <style name="Widget.AiAi.SwipeRefresh" parent="">
        <item name="setProgressBackgroundColorScheme">@color/surface</item>
        <item name="setColorSchemeResources">@color/primary</item>
    </style>

    <!-- ========== RecyclerView ========== -->
    <style name="Widget.AiAi.RecyclerView" parent="">
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingTop">@dimen/spacing_sm</item>
        <item name="android:paddingBottom">@dimen/spacing_sm</item>
    </style>

    <!-- ========== WebView样式 ========== -->
    <style name="Widget.AiAi.WebView" parent="">
        <item name="android:background">@color/bg_page</item>
    </style>

    <!-- ========== 头像样式 ========== -->
    <style name="Widget.AiAi.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ========== 搜索框样式 ========== -->
    <style name="Widget.AiAi.SearchView" parent="Widget.Material3.SearchBar">
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:hint">@string/hint_input_search</item>
    </style>

    <!-- ========== 快捷设置 ========== -->
    <style name="Widget.AiAi.Preference" parent="PreferenceScreen.Material3">
        <item name="android:iconSpaceReserved">true</item>
    </style>

    <!-- ========== Snackbar样式 ========== -->
    <style name="Widget.AiAi.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="snackbarTextViewStyle">@style/TextAppearance.AiAi.Snackbar</item>
    </style>

    <style name="TextAppearance.AiAi.Snackbar" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/white</item>
    </style>

</resources>
